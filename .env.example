# Copy this file to .env and fill in real values. Never commit .env.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b

# Required initial account: username 1–80 ASCII letters/numbers/_/-, password 12+ characters (max 1024 bytes)
APP_USERNAME=
APP_PASSWORD=

# Random long string used to sign session cookies
SESSION_SECRET=

# Canonical local origin; also checked for browser mutation requests
APP_URL=http://localhost:3000

PORT=3000

# Optional private storage location, outside the repository
# RAYGPT_DATA_DIR=/absolute/private/path

# Explicitly opt in to sending facts.md to General Assistant only
SEND_STANDING_FACTS=false

# Optional comma-separated trusted proxy IPs/subnets; never use blanket trust
# TRUST_PROXY=loopback

# NODE_ENV=production is blocked pending the persistent-session database task
