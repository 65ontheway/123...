# Copy this file to .env and fill in real values. Never commit .env.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b

# Max tokens the model can generate per reply. Raise this if replies feel cut
# short; lower it if replies tend to run on. If a reply hits this limit, the
# chat UI shows a small "cut off" note.
MAX_RESPONSE_TOKENS=1024

# Login credentials for the app
APP_USERNAME=admin
APP_PASSWORD=changeme

# Random long string used to sign session cookies
SESSION_SECRET=please-change-this-to-a-random-string

# Used for OpenRouter's HTTP-Referer header; set to your real deployed URL in production
APP_URL=http://localhost:3000

PORT=3000
